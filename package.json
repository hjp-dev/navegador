{
  "name": "infinity",
  "version": "1.1.1",
  "description": "Infinity: navegador web minimalista basado en Chromium (Electron) para redes internas (pestañas, favoritos, descargas y antenas Ubiquiti).",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.hjp.infinity",
    "productName": "Infinity",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network;WebBrowser",
      "executableName": "infinity",
      "maintainer": "hjp-dev <hjp-dev@users.noreply.github.com>",
      "synopsis": "Infinity: navegador minimalista para redes internas",
      "extraResources": [
        {
          "from": "build/linux/apparmor-profile",
          "to": "apparmor-profile"
        }
      ],
      "icon": "build/icons"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "icon": "build/icon.png"
  },
  "author": {
    "name": "hjp-dev",
    "email": "hjp-dev@users.noreply.github.com"
  },
  "homepage": "https://github.com/hjp-dev/navegador"
}
